# =====================================================================
#  BACKUP private DNS server — Phase 2, Extension A
#  Runs on a machine OTHER than Mac 1 (default: Mac 3, {{DNS_BACKUP_IP}}).
#  Serves the IDENTICAL {{TEAM}}.test zone.
#
#  Client Macs list BOTH resolvers (primary first):
#     sudo networksetup -setdnsservers Wi-Fi {{MAC1_IP}} {{DNS_BACKUP_IP}}
#  When the primary is stopped, macOS automatically falls back to this
#  server within ~seconds — that failover IS the demonstration.
#
#  Generated by scripts/configure.sh from templates/dnsmasq-backup.conf.tmpl
# =====================================================================

port={{DNS_PORT}}
# Only this machine's LAN IP — do NOT add 127.0.0.1 here in the local
# single-machine simulation, or it collides with the primary instance.
listen-address={{DNS_BACKUP_IP}}
# bind-dynamic: bind exactly the address above (no wildcard socket), so
# primary and backup instances coexist on port 53 in the local simulation.
bind-dynamic

domain={{TEAM}}.test
local=/{{TEAM}}.test/
domain-needed
bogus-priv
local-ttl={{DNS_TTL}}

# ---- SAME records as the primary (that's the requirement) ----
address=/app.{{TEAM}}.test/{{MAC2_IP}}
address=/api.{{TEAM}}.test/{{MAC2_IP}}
address=/backend-a.{{TEAM}}.test/{{MAC3_IP}}
address=/backend-b.{{TEAM}}.test/{{MAC4_IP}}
address=/edge-standby.{{TEAM}}.test/{{MAC3_IP}}
address=/ns1.{{TEAM}}.test/{{MAC1_IP}}
address=/ns2.{{TEAM}}.test/{{DNS_BACKUP_IP}}

log-queries
log-facility={{RUN_DIR}}/dnsmasq-backup-queries.log
pid-file={{RUN_DIR}}/dnsmasq-backup.pid
