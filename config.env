# =====================================================================
#  TEAM CONFIGURATION — the single source of truth for the project.
#
#  1) Fill in your team name and the 4 LAN IP addresses of your Macs
#     (find them with:  ifconfig | grep "inet " | grep -v 127.0.0.1)
#  2) Run:  ./scripts/configure.sh
#     -> regenerates every machine-ready file under deploy/
#
#  Every script in this repo reads this file. Change a value here,
#  re-run configure.sh, and the whole project follows.
# =====================================================================

# Team name -> private domain:  app.<TEAM>.test  /  api.<TEAM>.test
# (The brief mandates the reserved .test namespace — never .local,
#  which collides with macOS mDNS/Bonjour.)
TEAM="team1"

# --- The four machines on your shared private LAN (Task A) -----------
MAC1_IP="10.7.14.12"   # Mac 1 — private DNS server (dnsmasq) + test client
MAC2_IP="10.7.4.94"   # Mac 2 — EDGE: nginx reverse proxy + LB + TLS
MAC3_IP="10.7.15.253"   # Mac 3 — Backend A
MAC4_IP="10.7.17.142"   # Mac 4 — Backend B + test client

# --- Phase 2, Extension A: backup DNS resolver -----------------------
# Must run on a machine OTHER than Mac 1 (default: Mac 3).
DNS_BACKUP_IP="$MAC3_IP"

# --- Ports ------------------------------------------------------------
# The brief allows 8443/8080 instead of 443/80 with no mark deduction.
# Our nginx listens on BOTH 443 and 8443, so either works on the day.
DNS_PORT="53"
BACKEND_A_PORT="3001"
BACKEND_B_PORT="3002"
HTTPS_PORT="443"
HTTPS_ALT_PORT="8443"
HTTP_PORT="80"
HTTP_ALT_PORT="8080"

# --- DNS TTL (seconds) for all project records ------------------------
# Intentionally short so Phase 2 Extension B (record change + cache
# expiry + manual flush) can be demonstrated live in ~30 seconds.
DNS_TTL="30"

# --- Optional: upstream DNS for non-.test names -----------------------
# By default dnsmasq forwards via the Mac's system resolver, so client
# Macs keep normal internet access. If your lab requires an explicit
# upstream (e.g. the router), set it here and uncomment the server=
# line in templates/dnsmasq.conf.tmpl.
# GATEWAY_IP="192.168.1.1"
